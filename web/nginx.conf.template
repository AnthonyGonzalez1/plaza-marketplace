# nginx site for the Plaza SPA.
#
# This is a template: when the container starts, the image entrypoint replaces ${API_UPSTREAM}
# and ${NGINX_LOCAL_RESOLVERS} with the values of those environment variables and writes the
# result to /etc/nginx/conf.d/default.conf. nginx's own variables ($uri, $host, $api_upstream)
# are left untouched because they are not environment variables.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # The upstream address is kept in a variable on purpose. With a literal host in proxy_pass,
    # nginx resolves the name once at startup and refuses to start if the backend is not up
    # yet. With a variable it resolves the name per request using the "resolver" below, so the
    # web container starts on its own and answers 502 until the backend is reachable.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};

    # REST API and its OpenAPI docs: forwarded to store-api with the original path.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/(swagger-ui|v3/api-docs) {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite puts a content hash in every file name under /assets, so a file never changes:
    # browsers may cache it for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html must never be cached, otherwise users keep loading old asset names after a
    # deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # History fallback: any other path (e.g. /products/12) is a client-side route, so serve
    # index.html and let React Router show the right page.
    location / {
        try_files $uri /index.html;
    }
}
