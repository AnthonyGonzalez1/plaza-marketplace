{
  "name": "plaza-notification-service",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "amqplib": "2.4.0",
    "nodemailer": "10.6.1",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.73.0"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": "[.]spec[.]ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+[.]ts$": "ts-jest"
    }
  }
}
