# Every variable is optional: the values below are the defaults.
# The app reads real environment variables only. To use a file, copy this one to .env and start
# with: node --env-file=.env dist/main.js

# HTTP port (only GET /health).
PORT=3002
# RabbitMQ, where the order events come from.
RABBITMQ_URL=amqp://plaza:plaza@localhost:5672
# Redis, where the service remembers which events already produced an email.
REDIS_URL=redis://localhost:6379
# SMTP server that receives the emails. No user, password or TLS: it is meant for Mailpit, a
# fake mail server for development.
SMTP_HOST=localhost
SMTP_PORT=1025
# Sender of every email.
MAIL_FROM=Plaza Marketplace <no-reply@plaza.localhost>
# Public address of the web shop, used for the link to the order inside the emails.
WEB_BASE_URL=http://localhost:3000
# Attempts per message before it is parked in the dead-letter queue.
MAX_ATTEMPTS=3
# Wait before each retry. Changing it requires deleting the queue
# notifications.order-events.retry first (see the README).
RETRY_DELAY_MS=5000
