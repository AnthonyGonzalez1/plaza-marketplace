# Every variable is optional: the values below are the defaults.
# The app reads real environment variables only. To use a file, copy this one to .env and start
# with: node --env-file=.env dist/main.js

# HTTP port.
PORT=3001
# Where the payment results are sent.
WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/payments
# Shared secret for the HMAC signature. The receiver must be configured with the same value.
WEBHOOK_SECRET=local-dev-webhook-secret
# Wait between accepting a payment and sending its webhook.
PAYMENT_DELAY_MS=2000
# APPROVED or DECLINED, used when the request has no "simulateOutcome".
DEFAULT_OUTCOME=APPROVED
# true = every webhook is delivered twice (to show that the receiver is idempotent).
DUPLICATE_WEBHOOKS=false
# Delivery attempts per webhook.
WEBHOOK_MAX_ATTEMPTS=3
# Wait before the first retry; doubles on each further retry.
WEBHOOK_RETRY_DELAY_MS=1000
