# Copy this file to .env (ignored by git) and change what you need.
# Every variable is optional: the values below are the defaults used when it is not set.
# These are local development values only. Never put real credentials in this file.

# --- PostgreSQL (compose.yaml) ---
PLAZA_DB_NAME=plaza
PLAZA_DB_USER=plaza
PLAZA_DB_PASSWORD=plaza
# Host port where PostgreSQL is published. Change it if 5432 is already in use on your machine.
PLAZA_DB_PORT=5432

# --- Redis (compose.yaml) ---
# Host port where Redis is published. Change it if 6379 is already in use on your machine.
PLAZA_REDIS_PORT=6379

# --- store-api ---
# Host port where the API is published by compose.
PLAZA_API_PORT=8080
# JDBC URL used when the API runs outside Docker (./mvnw spring-boot:run reads it from the
# shell environment, not from this file). Keep the port equal to PLAZA_DB_PORT. Inside compose
# the URL is set automatically to the postgres service.
PLAZA_DB_URL=jdbc:postgresql://localhost:5432/plaza
# Redis used when the API runs outside Docker. Inside compose the host is the redis service.
PLAZA_REDIS_HOST=localhost
# How long an untouched cart lives, and how long an order waits for its payment.
PLAZA_CART_TTL=7d
PLAZA_ORDER_PAYMENT_WINDOW=15m
# Comma-separated origins of the web apps allowed to call the API from a browser (CORS).
PLAZA_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Spring profile. "prod" writes logs as JSON (one object per line); use "default" for
# human-readable logs.
SPRING_PROFILES_ACTIVE=prod

# --- web ---
# Host port where the web app is published by compose.
PLAZA_WEB_PORT=3000
